# Data and model artefacts -- large, regenerable, or private
data/
outputs/
logs/
*.pt
*.ckpt
*.npz
*.h5

# Generated results and samples (tables in results/ are tracked)
/results/samples/
/results/private_inference/
/archive/

# Vendored virtualenvs and caches
**/.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Backups
_backup_*/
_removed_from_DiGress/

# Third-party checkouts with their own git history
graph-coarsening/
k-mis-pool/
DiGress/

# Downloaded external graphs (networkrepository.com)
/datasets_external/

# Windows download markers
*:Zone.Identifier

# Paper drafts and working notes (kept out of the code repository)
/ICDE_main*.tex
/DP_Graph_syn*.pdf
/Synthetic Graph Generation.xlsx
/results/paper_changes.md
/results/paper_todo.xlsx
/results/todo_deadline.xlsx

# Exported competitor data is regenerable; keep only the fixed test groups
/results/competitor_data/**/*
!/results/competitor_data/**/
!/results/competitor_data/**/test_groups*.json
!/results/competitor_data/README.md

# Run logs
/results/**/*.log
